#pragma once
#include <array>
#include <string_view>

namespace RumpelQuiz::FrontendAssets {
// Literal lengths are supplied directly, avoiding constexpr scans of large assets.
using std::literals::string_view_literals::operator""sv;

struct Asset {
    std::string_view path;
    std::string_view content_type;
    std::string_view content;
};

inline constexpr std::array<Asset, @FRONTEND_ASSET_COUNT@> kAssets = {{
@FRONTEND_ASSETS@}};
}  // namespace RumpelQuiz::FrontendAssets
